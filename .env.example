# Copy to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables (then redeploy).
# Never commit real keys: .env.local is git-ignored.

# --- Contact form (server-side only: read by api/contact.ts, never sent to
# --- the browser, so no VITE_ prefix) ---------------------------------------

# REQUIRED. Resend API key ("Sending access") from https://resend.com/api-keys.
# Create the Resend account with gouranglokwani27@gmail.com: its test sender
# (onboarding@resend.dev) delivers to the account owner's own address.
RESEND_API_KEY=

# OPTIONAL backup sender. Web3Forms access key from https://web3forms.com
# (enter gouranglokwani27@gmail.com; the key is emailed). Used only when
# Resend fails or isn't configured.
WEB3FORMS_KEY=

# --- Site ---------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical, Open Graph,
# JSON-LD, sitemap.xml and robots.txt. Defaults to https://gouranglokwani.in
VITE_SITE_URL=
