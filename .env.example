# Copy to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables (then redeploy).

# OPTIONAL backup sender for the contact form. The primary sender, FormSubmit,
# needs no key. Web3Forms public access key: get one free at
# https://web3forms.com by entering gouranglokwani27@gmail.com (it is emailed).
VITE_WEB3FORMS_KEY=

# Public site URL (no trailing slash). Used for canonical, Open Graph,
# JSON-LD, sitemap.xml and robots.txt. Defaults to https://gouranglokwani.vercel.app
VITE_SITE_URL=
