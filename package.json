{
  "name": "gourang-lokwani-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "tsc -b && vite build && npm run build:shell",
    "build:shell": "vite build --ssr src/shell/entry-shell.tsx --outDir node_modules/.cache/shell-ssr --emptyOutDir --logLevel warn && node scripts/prerender-shell.mjs",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "seo": "node scripts/generate-seo.mjs",
    "test:contact": "playwright test tests/contact.spec.ts",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "check": "npm run typecheck && npm run build && npm run test:unit && npm run test:smoke"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "11.11.17",
    "lenis": "1.3.26",
    "lucide-react": "0.454.0",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "beasties": "0.5.4",
    "ffmpeg-static": "^5.2.0",
    "playwright-core": "^1.48.2",
    "postcss": "8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
